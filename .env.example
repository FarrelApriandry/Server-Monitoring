# NEXUS — self-hosted server telemetry dashboard
# Copy this file to `.env` (or export the variables) to override defaults.
# When left empty, a random admin password is generated on first startup and
# written to ./data/password.txt (as well as printed to the console).

# Password to access the dashboard (min 8 chars recommended).
NEXUS_PASSWORD=

# Optional webhook: receive POST JSON alert payloads (Discord/Teams/ntfy...).
NEXUS_WEBHOOK_URL=

# Telemetry collection interval in milliseconds (default 1500, min 500).
NEXUS_REFRESH_MS=1500

# How many days of history to retain in ./data/telemetry.db (default 7).
NEXUS_HISTORY_DAYS=7

# Production server bind settings (used by the @astrojs/node standalone entry).
# Default: 0.0.0.0:4321 — the auth layer protects the dashboard, but you can
# restrict to localhost for single-user setups.
HOST=0.0.0.0
PORT=4321
